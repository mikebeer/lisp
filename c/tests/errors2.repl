(defun try (f) (handler-case (funcall f) (error (e) (format t "ERR: ~a~%" e) 'err)))
(print (try (lambda () (car 5))))
(print (try (lambda () (/ 1 0))))
(print (try (lambda () (/ 1.0 0))))
(print (try (lambda () (undefined-fn 1))))
(print (try (lambda () undefined-var)))
(print (try (lambda () (+ 'a 1))))
(print (try (lambda () (error "boom ~a ~s" 1 "x"))))
(print (try (lambda () (aref (vector 1 2) 5))))
(print (try (lambda () (nth -1 '(1 2)))))
(print (try (lambda () (elt '(1 2) 9))))
(print (try (lambda () (funcall 5))))
(print (try (lambda () (apply #'+ 1 2))))
(print (try (lambda () (gethash))))
(print (try (lambda () (subseq "abc" 2 10))))
(print (try (lambda () (parse-integer "x"))))
(print (try (lambda () (char "abc" 7))))
(print (try (lambda () (symbol-value 'zzz))))
(print (try (lambda () (throw 'foo 1))))
(print (catch 'foo (throw 'foo 42)))
(print (block b (return-from b 7) 8))
(print (try (lambda () (return-from nob 1))))
(print (try (lambda () (assert (= 1 2)))))
(print (try (lambda () (check-type 5 string))))
(print (try (lambda () (let ((x 1) (y)) (+ x y)))))
(print (try (lambda () (mod 5 0))))
(print (try (lambda () (sqrt -1))))
(print (try (lambda () (log 0))))
(print (try (lambda () (coerce 'a 'string))))
(print (try (lambda () (length 5))))
(print (try (lambda () (reverse 5))))
(print (try (lambda () (make-array -1))))
(print (try (lambda () (string-upcase 5))))
(print (try (lambda () (char-code "a"))))
(print (try (lambda () (1+ nil))))
(print (try (lambda () (max))))
(print (try (lambda () (min 'a 1))))
(print (try (lambda () (list-length 5))))
(print (try (lambda () (nthcdr 'a '(1)))))
(print (try (lambda () (let ((a 1)) (setf (car a) 3)))))
(print (handler-case (signal 'my-cond) (condition (c) c)))
(print (ignore-errors (car 1)))
(print (multiple-value-list (ignore-errors (car 1))))
(unwind-protect (print 'body) (print 'cleanup))
(print (try (lambda () (unwind-protect (error "x") (print 'cleanup2)))))
(handler-bind ((error (lambda (e) (print (list 'hb e))))) (try (lambda () (error "inner"))))
(print (try (lambda () (cerror "c" "d"))))
(print (try (lambda () (warn "w"))))
(car 5)
(print 'after)
(error "top ~a" 'level)
(throw 'zz 1)
(return-from q 1)
(print (funcall (lambda (&optional (a 1) &key (b 2) c) (list a b c)) 5 :c 3))
(print (try (lambda () (funcall (lambda (a) a)))))
(print (try (lambda () (funcall (lambda (a) a) 1 2))))
(print (try (lambda () (funcall (lambda (&key a) a) :b 1))))
(defun deep (n) (if (= n 0) 0 (+ 1 (deep (- n 1)))))
(print (deep 1000))
(print (try (lambda () (deep 30000))))
(print (deep 20000))
