(print (loop for i from 1 to 5 collect i))
(print (loop for i from 1 below 10 by 3 collect i))
(print (loop for i from 10 downto 1 by 4 collect i))
(print (loop for x in '(1 2 3) sum x))
(print (loop for x in '(1 2 3) maximize x))
(print (loop for x in '(3 1 2) minimize x))
(print (loop for x across #(1 2 3) collect (* x x)))
(print (loop for (a . b) in '((1 . 2) (3 . 4)) collect (+ a b)))
(print (loop for x on '(1 2 3) collect x))
(print (loop for i from 0 for x in '(a b c) collect (list i x)))
(print (loop for x in '(1 2 3 4 5) when (evenp x) collect x))
(print (loop for x in '(1 2 3 4 5) unless (evenp x) collect x))
(print (loop for x in '(1 2 3 4 5) if (evenp x) collect x else collect (- x)))
(print (loop for x in '(1 2 3) append (list x x)))
(print (loop for x in '(1 2 3) count (oddp x)))
(print (loop with s = 0 for i from 1 to 4 do (incf s i) finally (return s)))
(print (loop repeat 3 collect 'x))
(print (loop for i from 1 while (< i 5) collect i))
(print (loop for i from 1 until (> i 4) collect i))
(print (loop for x in '(1 2 3) thereis (and (> x 1) x)))
(print (loop for x in '(1 2 3) always (> x 0)))
(print (loop for x in '(1 2 3) never (> x 5)))
(print (loop for i below 3 nconc (list i)))
(print (loop for x = 1 then (* x 2) repeat 6 collect x))
(print (loop for k being the hash-keys of (let ((h (make-hash-table))) (setf (gethash 'a h) 1) h) collect k))
(print (loop named foo for i from 1 do (when (> i 3) (return-from foo i))))
(print (loop for i from 1 to 3 collect i into l finally (return (reverse l))))
(print (loop for x in '(1 2) for y in '(a b c) collect (cons x y)))
(print (loop for i from 1 to 3 do (princ i) finally (terpri)))
(loop (return))
(print (dotimes (i 3 'done) (princ i)))
(print (dolist (x '(1 2) 'ok) (princ x)))
(print (do ((i 0 (1+ i)) (acc nil (cons i acc))) ((= i 4) acc)))
(print (do* ((i 0 (1+ i)) (j (* 2 i) (* 2 i))) ((= i 3) j)))
(print (let ((r nil)) (dotimes (i 3) (push i r)) r))
(print (prog1 1 2 3))
(print (prog2 1 2 3))
(print (progn))
(print (cond ((= 1 2) 'a) ((= 1 1)) (t 'c)))
(print (case 3 (1 'one) ((2 3) 'twothree) (otherwise 'other)))
(print (case 'x (x 1) (t 2)))
(print (ecase 1 (1 'a)))
(print (typecase 5 (string 's) (integer 'i) (t 'o)))
(print (when nil 1))
(print (unless nil 1 2))
(print (and 1 2 3))
(print (or nil nil 3))
(print (let* ((a 1) (b (+ a 1))) (list a b)))
(print (flet ((f (x) (* x 2))) (f 4)))
(print (labels ((f (n) (if (= n 0) 1 (* n (f (- n 1)))))) (f 20)))
(print (let ((x 1)) (let ((f (lambda () (incf x)))) (funcall f) (funcall f) x)))
(defvar *v* 10)
(defun getv () *v*)
(print (let ((*v* 20)) (getv)))
(print (getv))
(defparameter *p* 1)
(defconstant +c+ 5)
(print (list *p* +c+))
(print (multiple-value-bind (a b) (values 1 2) (list a b)))
(print (multiple-value-list (floor 7 2)))
(print (multiple-value-list (truncate -7 2)))
(print (multiple-value-list (round 2.5)))
(print (multiple-value-list (ceiling 7 2)))
(print (multiple-value-list (floor -7 2)))
(print (multiple-value-list (values)))
(print (nth-value 1 (values 1 2 3)))
(print (multiple-value-call #'list (values 1 2) (values 3)))
(print (destructuring-bind (a (b c) &rest d) '(1 (2 3) 4 5) (list a b c d)))
(print (let ((i 0)) (loop (incf i) (when (> i 5) (return i)))))
(print (tagbody (go a) (print 'skipped) a (print 'here)))
(print (let ((x 5)) (setq x 6) x))
(print (psetq))
