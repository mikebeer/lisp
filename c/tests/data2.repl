(defvar h (make-hash-table))
(setf (gethash 'a h) 1 (gethash 'b h) 2 (gethash "s" h) 3 (gethash 1.5 h) 4 (gethash '(1 2) h) 5)
(print (list (gethash 'a h) (gethash "s" h) (gethash 1.5 h) (gethash '(1 2) h) (gethash 'zz h)))
(print (multiple-value-list (gethash 'a h)))
(print (multiple-value-list (gethash 'q h 'dflt)))
(print (hash-table-count h))
(print (hash-table-keys h))
(print (hash-table-values h))
(remhash 'a h)
(print (hash-table-count h))
(maphash (lambda (k v) (format t "~s=~s " k v)) h) (terpri)
(clrhash h)
(print (hash-table-count h))
(defvar h2 (make-hash-table :test 'equal))
(setf (gethash "k" h2) 'v)
(setf (gethash '(1 2) h2) 'l)
(print (list (gethash "k" h2) (gethash (list 1 2) h2)))
(defvar h3 (make-hash-table :test #'equalp))
(setf (gethash "AbC" h3) 1)
(print (gethash "abc" h3))
(print h)
(print (hash-table-p h))
(incf (gethash 'cnt h 0))
(incf (gethash 'cnt h 0) 5)
(print (gethash 'cnt h))
(push 1 (gethash 'lst h))
(push 2 (gethash 'lst h))
(print (gethash 'lst h))
(dotimes (i 50) (setf (gethash i h) (* i i)))
(print (hash-table-count h))
(print (gethash 49 h))
(print (loop for k being the hash-keys of h using (hash-value v) when (< k 3) collect (list k v)))
(defstruct point x y)
(defvar p (make-point :x 1 :y 2))
(print p)
(print (list (point-x p) (point-y p) (point-p p) (point-p 5)))
(setf (point-x p) 10)
(print (point-x p))
(print (copy-point p))
(print (type-of p))
(defstruct (shape (:constructor new-shape (name &optional (sides 0)))) name sides)
(print (new-shape "tri" 3))
(defstruct (circle (:include shape)) (r 1))
(print (make-circle :name "c" :r 5))
(defstruct acct (bal 100) (owner "me"))
(print (make-acct))
(print (acct-bal (make-acct :bal 5)))
(print (string-upcase "hello") )
(print (list (string-downcase "HeLLo") (string-capitalize "hello wORLD") (string-trim " " "  hi  ") (string-left-trim "ab" "aabcab") (string-right-trim "ab" "abcaab")))
(print (list (string= "a" "a") (string< "a" "b") (string> "a" "b") (string-equal "A" "a") (string<= "a" "a") (string>= "b" "a") (string-lessp "a" "B") (string-greaterp "b" "A")))
(print (list (search "lo" "hello") (search "zz" "hello") (search '(2 3) '(1 2 3)) (search "l" "hello" :from-end t) (search "l" "hello" :start2 3)))
(print (list (subseq "hello" 1 3) (subseq "hello" 2) (subseq '(1 2 3 4) 1 3) (subseq #(1 2 3 4) 2)))
(print (list (concatenate 'string "ab" "cd") (concatenate 'list '(1) #(2) "a") (concatenate 'vector '(1) '(2))))
(print (list (char "abc" 1) (char-upcase #\a) (char-downcase #\A) (char-code #\a) (code-char 66) (char< #\a #\b) (char= #\a #\a) (char-equal #\a #\A) (alpha-char-p #\a) (digit-char-p #\7) (digit-char 7) (alphanumericp #\_) (upper-case-p #\A) (lower-case-p #\A)))
(print (list (string 'abc) (string #\a) (string "x") (symbol-name 'foo) (make-string 3 :initial-element #\z) (make-string 2)))
(print (list (parse-integer "123") (parse-integer " 42 ") (parse-integer "-7") (parse-integer "ff" :radix 16) (parse-integer "12abc" :junk-allowed t)))
(print (list (read-from-string "(1 2 . 3)") (read-from-string "#(1 2)") (read-from-string "\"str\"") (read-from-string "'a") (read-from-string "#\\x")))
(print (list (princ-to-string 1.5) (prin1-to-string "a") (write-to-string '(a "b")) (format nil "~s" 'a)))
(print (list (intern "foo") (intern "FOO") (make-symbol "x") (symbol-name (gensym)) (keywordp :a) (keywordp 'a)))
(print (list (coerce '(1 2) 'vector) (coerce #(1 2) 'list) (coerce "ab" 'list) (coerce 1 'float) (coerce 2.5 'integer) (coerce '(#\a #\b) 'string)))
(print (list (type-of 1) (type-of 1.5) (type-of "s") (type-of 'a) (type-of nil) (type-of '(1)) (type-of #(1)) (type-of #\a) (type-of #'car) (type-of (lambda ()))))
(print (list (typep 1 'integer) (typep 1 'number) (typep 1.0 'float) (typep "s" 'string) (typep nil 'null) (typep nil 'list) (typep 'a 'symbol) (typep '(1) 'cons) (typep #(1) 'vector) (typep 1 'string) (typep 1 t)))
(print (get 'foo 'bar))
(setf (get 'foo 'bar) 5)
(print (list (get 'foo 'bar) (get 'foo 'baz 'd) (symbol-plist 'foo)))
(print (list (getf '(:a 1 :b 2) :b) (getf '(:a 1) :z 9)))
(setf (symbol-value 'dyn) 3)
(print (list (symbol-value 'dyn) (boundp 'dyn) (boundp 'nonexist) (fboundp 'car) (fboundp 'nonexist)))
