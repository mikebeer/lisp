(format t "~a ~s ~d ~b ~o ~x ~%" "s" "s" 42 5 64 255)
(format t "~5d|~5,'0d|~-5d|~:d|~@d~%" 42 42 42 1234567 5)
(format t "~10a|~10@a|~3a|~%" "abc" "abc" "abcdef")
(format t "~f ~5,2f ~,3f ~10,1f ~e~%" 3.14159 3.14159 2.0 99.99 1234.5)
(format t "~$ ~2$ ~8,3$~%" 3.14159 2.5 1.0)
(format t "~{~a~^, ~}~%" '(1 2 3))
(format t "~{~a ~a~^; ~}~%" '(1 2 3 4))
(format t "~:{(~a ~a)~}~%" '((1 2) (3 4)))
(format t "~@{~a ~}~%" 1 2 3)
(format t "~[zero~;one~;two~:;many~]~%" 1)
(format t "~[zero~;one~;two~:;many~]~%" 9)
(format t "~:[no~;yes~]~%" nil)
(format t "~@[x=~a~]~%" 5)
(format t "~(HELLO World~) ~:(hello world~) ~@(hello world~) ~:@(hello~)~%" )
(format t "~r ~r ~:r~%" 4 21 3)
(format t "~c ~s ~c~%" #\a #\b #\Space)
(format t "~%~&~&x~&~%")
(format t "~a~10t|~a~%" "a" "b")
(format t "~~ ~5% ~2&~%")
(format t "~*~a ~2*~a~%" 1 2 3 4 5)
(format t "~a ~a~%" 'sym "str")
(format t "~s ~s ~s~%" 'sym "str" #\c)
(format t "~12,'*d~%" 99)
(format t "~v,vd~%" 8 #\- 5)
(format t "~#d~%" 1 2)
(format t "~3,1f ~f ~f~%" 0.05 100 1e10)
(format t "~a ~a ~a~%" 1.5 -0.0 1d0)
(format t "~a~%" '(1 "a" #\b (c . d)))
(format t "~s~%" '(1 "a" #\b (c . d) 1.5 nil t))
(print (format nil "~a-~a" 1 2))
(princ "x") (princ 1.5) (terpri)
(prin1 "q\"uo\\te") (terpri)
(print (list 1 2.0 "s" #\a 'sym :kw nil t))
(write 'x) (write-line "wl") (write-string "ws") (write-char #\z) (terpri)
(format t "~a" nil) (format t "~%")
(format t "no newline")
(format t "~&fresh~&line~%")
(print (format nil "~10,3f|~-10,3f|" 3.14159 3.14159))
(print (format nil "~,2f" 2.675))
(print (format nil "~,0f" 2.5))
(print (format nil "~d" 12345678901234))
(print (format nil "~x" -255))
(print (format nil "~:x" 255))
(print (format nil "~8,'0b" 37))
(format t "~{~a~}~%" nil)
(format t "~{~{~a~^ ~}~^/~}~%" '((1 2) (3 4)))
(format t "~2{~a~}~%" '(1 2 3 4))
(format t "~a~^x~%" 1)
(format t "~?~%" "~a ~a" '(1 2))
(format t "~/~%")
